# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,tscn,tres,godot}]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100

[*.{cs}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

[*.{md,txt,rst}]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
